# Text files are stored with LF line endings on every platform.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.pdf binary
*.ttf binary
*.woff2 binary
*.onnx binary
*.gz binary
*.zip binary
*.sig binary

# Unchanged copies of the files of GNU FreeFont (fonts/README.md): kept byte for byte.
fonts/AUTHORS -text
fonts/COPYING -text
fonts/CREDITS -text
fonts/README -text
